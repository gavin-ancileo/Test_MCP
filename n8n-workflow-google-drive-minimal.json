{
  "name": "Google Drive Change Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "drive-webhook",
        "responseMode": "onReceived"
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {},
      "name": "No Operation",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [450, 300],
      "notes": "Replace this with Send Email node after configuring SMTP credentials in n8n UI"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{"node": "No Operation", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
