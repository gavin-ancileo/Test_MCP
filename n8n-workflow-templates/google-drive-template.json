{
  "name": "[TEMPLATE] Google Drive Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "drive",
        "responseMode": "onReceived"
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300],
      "webhookId": "drive-webhook"
    },
    {
      "parameters": {},
      "name": "Process Drive Event",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [450, 300],
      "notes": "Replace this with Send Email node or other processing nodes after configuring SMTP credentials in n8n UI"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{"node": "Process Drive Event", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["integration:google-drive", "template"]
}
