# ============================================
# ANCILEO - LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE
# ============================================
# 📋 INSTRUCTIONS:
# 1. Copy this file to .env.local
# 2. Fill in your actual credentials
# 3. Never commit .env.local to git
# ============================================

# Environment
ENVIRONMENT=local

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aap_db
DB_USER=postgres
DB_PASSWORD=postgres123

# ============================================
# AWS CONFIGURATION
# ============================================
# Get from: AWS IAM Console → Users → Security Credentials
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY_HERE
AWS_DEFAULT_REGION=ap-southeast-2
DYNAMODB_TABLE=aap-conversations

# ============================================
# OPENAI CONFIGURATION
# ============================================
# Get from: https://platform.openai.com/api-keys
USE_OPENAI=true
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

# ============================================
# COGNITO AUTHENTICATION
# ============================================
# Get from: AWS Cognito Console → User Pools
COGNITO_USER_POOL_ID=YOUR_COGNITO_POOL_ID
COGNITO_REGION=ap-southeast-2
COGNITO_DOMAIN=https://your-cognito-domain.auth.ap-southeast-2.amazoncognito.com
COGNITO_CLIENT_ID=YOUR_COGNITO_CLIENT_ID

# ============================================
# OAUTH INTEGRATIONS - GITHUB
# ============================================
# Get from: https://github.com/settings/developers
# Callback URL: http://localhost/callback/github
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
GITHUB_REDIRECT_URI=http://localhost/callback/github

# ============================================
# OAUTH INTEGRATIONS - JIRA
# ============================================
# Get from: https://developer.atlassian.com/console/myapps/
# Callback URL: http://localhost/callback/jira
JIRA_CLIENT_ID=YOUR_JIRA_CLIENT_ID
JIRA_CLIENT_SECRET=YOUR_JIRA_CLIENT_SECRET
JIRA_REDIRECT_URI=http://localhost/callback/jira

# ============================================
# OAUTH INTEGRATIONS - GOOGLE DRIVE
# ============================================
# Get from: https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost/callback/google
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost/callback/google

# ============================================
# APPLICATION CONFIGURATION
# ============================================
MCP_URL=http://mcp-server:8001
FORCE_ADMIN_MODE=true

# ============================================
# FRONTEND CONFIGURATION
# ============================================
VITE_COGNITO_DOMAIN=https://your-cognito-domain.auth.ap-southeast-2.amazoncognito.com
VITE_COGNITO_CLIENT_ID=YOUR_COGNITO_CLIENT_ID
VITE_COGNITO_USER_POOL_ID=YOUR_COGNITO_POOL_ID
VITE_COGNITO_REGION=ap-southeast-2
VITE_COGNITO_REDIRECT_URI=http://localhost/callback
VITE_AGENTCORE_URL=http://localhost:8000/agentcore
VITE_ENVIRONMENT=local
