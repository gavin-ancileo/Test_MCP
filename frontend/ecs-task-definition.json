{
  "family": "aap-enduser-frontend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "aap-enduser-frontend",
      "image": "YOUR_ECR_REPOSITORY_URI:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "VITE_COGNITO_DOMAIN",
          "value": "https://aap-uat-20251014.auth.ap-southeast-2.amazoncognito.com"
        },
        {
          "name": "VITE_COGNITO_CLIENT_ID",
          "value": "20bsno0fmojtchqem9vacrlivt"
        },
        {
          "name": "VITE_COGNITO_USER_POOL_ID",
          "value": "ap-southeast-2_TFmPkO0Lc"
        },
        {
          "name": "VITE_COGNITO_REGION",
          "value": "ap-southeast-2"
        },
        {
          "name": "VITE_COGNITO_REDIRECT_URI",
          "value": "https://YOUR-FRONTEND-ALB.ap-southeast-2.elb.amazonaws.com/callback"
        },
        {
          "name": "VITE_API_BASE_URL",
          "value": "http://YOUR-BACKEND-ALB.ap-southeast-2.elb.amazonaws.com/agentcore"
        },
        {
          "name": "VITE_AGENTCORE_URL",
          "value": "http://YOUR-BACKEND-ALB.ap-southeast-2.elb.amazonaws.com/agentcore"
        },
        {
          "name": "VITE_ENABLE_GITHUB_INTEGRATION",
          "value": "true"
        },
        {
          "name": "VITE_ENABLE_JIRA_INTEGRATION",
          "value": "true"
        },
        {
          "name": "VITE_ENVIRONMENT",
          "value": "production"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/aap-enduser-frontend",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
