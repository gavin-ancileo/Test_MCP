    {
      "parameters": {
        "jsCode": "// Simple echo back the received data\nconst data = $input.all();\nreturn data.map(item => ({\n  json: {\n    message: \"Hello from n8n workflow!\",\n    received: item.json,\n    timestamp: new Date().toISOString(),\n    workflow: \"demo-workflow\"\n  }\n}));"
      },
      "id": "code-node",
      "name": "Process Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "response-node",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [650, 300]
    }
  ],
